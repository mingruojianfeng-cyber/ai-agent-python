APP_NAME=yu-ai-agent-python
APP_ENV=local
LLM_PROVIDER=deepseek
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_REASONING_EFFORT=
LLM_EXTRA_BODY_JSON=
REQUEST_TIMEOUT_SECONDS=60
CHAT_MEMORY_TYPE=memory
CHAT_MEMORY_MAX_MESSAGES=20
DATABASE_URL=sqlite+aiosqlite:///./chat_memory.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/yu_ai_agent
